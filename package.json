{
  "name": "steamtrain",
  "version": "0.1.0-alpha.2",
  "description": "Terminal orchestrator that runs coding agents (Claude Code, Grok Build, OpenCode, Codex, Amp) as managed subprocesses and renders their activity live in an Ink TUI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nilsonsfj/steamtrain.git"
  },
  "homepage": "https://github.com/nilsonsfj/steamtrain",
  "bugs": {
    "url": "https://github.com/nilsonsfj/steamtrain/issues"
  },
  "keywords": ["cli", "agent", "orchestrator", "workflow", "claude", "grok", "codex", "tui"],
  "type": "module",
  "bin": {
    "steamtrain": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": ["dist"],
  "engines": {
    "node": ">=20",
    "bun": ">=1"
  },
  "scripts": {
    "dev": "bun scripts/build-reducer.ts && bun src/index.tsx",
    "start": "node dist/index.js",
    "build": "bun scripts/build-reducer.ts && tsup && bun scripts/copy-assets.ts",
    "build:electron": "tsup --config tsup.electron.config.ts",
    "dev:electron": "npm run build && npm run build:electron && electron dist-electron/main.cjs",
    "build:icon": "bun scripts/build-icon.ts",
    "package:desktop": "npm run build && npm run build:electron && electron-builder --publish never",
    "package:desktop:dir": "npm run build && npm run build:electron && electron-builder --dir --publish never",
    "install:local": "bash scripts/install.sh",
    "uninstall:local": "bash scripts/uninstall.sh",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p tsconfig.e2e.json",
    "pretest": "bun scripts/build-reducer.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:web": "playwright test --project=web",
    "test:e2e:desktop": "playwright test --project=electron",
    "test:agent-smoke": "STEAMTRAIN_AGENT_SMOKE=1 vitest run tests/agent-cli-smoke.test.ts",
    "test:watch": "bun scripts/build-reducer.ts && vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "chalk": "^5.3.0",
    "ink": "^5.1.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@vitest/coverage-v8": "2.1.8",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.27.7",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "trustedDependencies": ["@biomejs/biome"]
}
