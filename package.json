{
  "name": "steamtrain",
  "version": "0.1.0",
  "description": "Terminal orchestrator that runs coding agents (Claude Code, OpenCode, Codex) as managed subprocesses and renders their activity live in an Ink TUI.",
  "type": "module",
  "bin": {
    "steamtrain": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": ["dist"],
  "engines": {
    "node": ">=20",
    "bun": ">=1"
  },
  "scripts": {
    "dev": "bun scripts/build-reducer.ts && bun src/index.tsx",
    "start": "node dist/index.js",
    "build": "bun scripts/build-reducer.ts && tsup",
    "typecheck": "tsc --noEmit",
    "pretest": "bun scripts/build-reducer.ts",
    "test": "vitest run",
    "test:watch": "bun scripts/build-reducer.ts && vitest",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "chalk": "^5.3.0",
    "ink": "^5.1.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "esbuild": "^0.27.7",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "trustedDependencies": ["@biomejs/biome"]
}
